---
import site from '../data/site.json';
import Mark from './Mark.astro';

interface Props {
    page: 'home' | 'manifesto' | 'hosts';
}

const { page } = Astro.props;
const pages = [
    { key: 'manifesto', label: 'manifesto', href: '/manifesto' },
    { key: 'hosts', label: 'hosts', href: '/hosts' },
];
const others = page === 'home' ? pages.filter((p) => p.key === 'hosts') : pages;
---

<nav class="nav">
    <a href="/" class="lockup" aria-label="Bangerlore home">
        <Mark width={30} />
        <span class="wordmark">banger<span class="wordmark-lore">lore</span></span>
    </a>
    <div class="links">
        {others.map((p) => <a href={p.href} class:list={{ current: p.key === page }}>{p.label}</a>)}
        <a href={site.links.twitter}>twitter</a>
        <a href={site.links.basedcon}>basedcon</a>
    </div>
</nav>

<style>
    .nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        font-size: 15px;
    }
    .lockup { display: flex; align-items: center; gap: 4px; color: var(--white); }
    .lockup:hover .wordmark { color: var(--red); }
    .wordmark { font-weight: 800; font-size: 22px; letter-spacing: -.04em; line-height: 1; color: var(--white); white-space: nowrap; }
    .links { display: flex; gap: 20px; flex-wrap: wrap; }
    .links a.current { color: var(--ink); }
    .links a.current:hover { color: var(--red); }
</style>
