---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icons from './Icons.astro';
import type { Tweet } from '@sites/shared/tweets';

interface Props { tweets: Tweet[] }

const { tweets } = Astro.props;
const avatarFiles = import.meta.glob<{ default: ImageMetadata }>('../../../../shared/data/avatars/*.{jpg,png}', { eager: true });
const avatars = Object.fromEntries(Object.entries(avatarFiles).map(([p, m]) => [p.split('/').pop()!, m.default]));
const avatarFor = (t: Tweet) => (t.avatar ? avatars[t.avatar.split('/').pop()!] : undefined);
const initials = (name: string) => name.split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase();
---

<div class="tweets">
    {tweets.map((t) => {
        const avatar = avatarFor(t);
        return (
            <a class="tweet" href={t.url} target="_blank" rel="noopener">
                <div class="head">
                    {avatar
                        ? <Image src={avatar} alt="" class="avatar" width={72} height={72} loading="lazy" />
                        : <span class="avatar initials" aria-hidden="true">{initials(t.name)}</span>}
                    <div class="who">
                        <div class="name">{t.name}</div>
                        <div class="handle">{t.handle}</div>
                    </div>
                    <span class="x"><Icons name="x" /></span>
                </div>
                <p class="text">{t.text}</p>
            </a>
        );
    })}
</div>

<style>
    .tweets { columns: 3 260px; column-gap: 12px; }
    .tweet {
        display: block;
        break-inside: avoid;
        margin-bottom: 12px;
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 16px 18px;
        color: var(--ink);
    }
    .tweet:hover { border-color: var(--red); color: var(--ink); }
    .head { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
    .avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        object-fit: cover;
        flex: none;
        background: #1a1a1a;
    }
    .initials {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 700;
        color: var(--ink-2);
        letter-spacing: .02em;
    }
    .who { min-width: 0; line-height: 1.25; }
    .name { font-size: 15px; font-weight: 600; color: var(--white); overflow-wrap: anywhere; }
    .handle { font-size: 13px; color: var(--ink-2); }
    .x { margin-left: auto; flex: none; color: var(--ink); display: inline-flex; }
    .text { font-size: 15px; line-height: 1.45; white-space: pre-line; text-wrap: pretty; overflow-wrap: anywhere; }
</style>
