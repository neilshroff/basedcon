---
import site from '../data/site.json';

interface Props {
    title?: string;
    description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, ''), Astro.site);
const ogImage = new URL('/og.jpg', Astro.site);
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0a0a0a" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
</head>
<body>
    <slot />
</body>
</html>

<style is:global>
    *, *::before, *::after { box-sizing: border-box; }

    :root {
        --bg: #0a0a0a;
        --surface: #141414;
        --white: #fff;
        --ink: #e8e4dc;
        --ink-2: #9a958d;
        --ink-3: #6b6b6b;
        --line: #2a2a2a;
        --line-soft: #3a3a3a;
        --ghost: #1e1e1e;
        --red: #e63946;
        --col: 960px;
        --gutter: 24px;
        color-scheme: dark;
    }

    html { background: var(--bg); }

    body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        font-size: 16px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
    }

    body.modal-open { overflow: hidden; }

    a { color: var(--red); text-decoration: none; }
    a:hover { color: var(--white); }

    button { font: inherit; color: inherit; cursor: pointer; }

    img { max-width: 100%; display: block; }

    :focus-visible { outline: 2px solid var(--red); outline-offset: 2px; }

    h1, h2, h3, p, ul, ol { margin: 0; }

    .col {
        max-width: var(--col);
        width: 100%;
        margin: 0 auto;
        padding-left: var(--gutter);
        padding-right: var(--gutter);
    }

    .label-grid {
        display: grid;
        grid-template-columns: 200px minmax(0, 1fr);
        gap: 40px;
        align-items: start;
    }

    .label {
        font-size: 14px;
        color: var(--ink-2);
        padding-top: 6px;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: 0;
        border-radius: 0;
        background: var(--red);
        color: var(--bg);
        padding: 13px 22px;
        font-size: 15px;
        font-weight: 600;
        line-height: 1.2;
        white-space: nowrap;
        text-decoration: none;
    }
    .btn:hover { background: var(--white); color: var(--bg); }
    .btn:disabled { opacity: .6; cursor: default; }
    .btn:disabled:hover { background: var(--red); }

    .btn-outline {
        background: transparent;
        color: var(--ink);
        border: 1px solid var(--ink);
        padding: 12px 22px;
    }
    .btn-outline:hover { background: transparent; border-color: var(--red); color: var(--red); }

    .text-btn {
        border: 0;
        background: none;
        padding: 0;
        color: var(--red);
        font-weight: 600;
        font-size: 15px;
    }
    .text-btn:hover { color: var(--white); }

    .photo-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px;
    }
    .photo-grid img {
        width: 100%;
        height: auto;
        aspect-ratio: 4 / 3;
        object-fit: cover;
    }

    .wordmark-lore { color: var(--red); }

    @media (max-width: 900px) {
        .label-grid { grid-template-columns: 1fr; gap: 12px; }
        .label { padding-top: 0; }
    }
    @media (max-width: 760px) {
        .photo-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 480px) {
        .photo-grid { grid-template-columns: 1fr; }
    }
</style>
