---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Modals from '../components/Modals.astro';
import Quotes from '../components/Quotes.astro';
import Lightbox from '../components/Lightbox.astro';
import site from '../data/site.json';
import { featuredFor } from '@sites/shared/tweets';
import { photos, hero, lbIndex } from '../data/photos';

const { nextEdition, editions, links } = site;
const tweets = featuredFor('bangerlore');
const imgProps = { widths: [360, 720], sizes: '(max-width: 480px) 100vw, (max-width: 760px) 50vw, 304px' };
---

<Base>
    <AnnouncementBar />

    <div class="col hero-wrap">
        <Nav page="home" />

        <div class="hero">
            <h1>Banger<span class="wordmark-lore">lore</span></h1>
            <p class="tagline">hosting tech parties we'd want to be attendees at</p>
            <p class="summary">Invite-only house party, Bangalore, since early 2024.<br />~250 people, every one vetted. 4PM to 4AM.</p>
            <div class="ctas">
                <a href="/manifesto" class="btn">Party manifesto</a>
                <button type="button" class="btn btn-outline" data-open-attend>Want to attend?</button>
            </div>
        </div>

        <div>
            <div class="photo-grid">
                {hero.map((p, i) => <Image src={p.src} alt={p.alt} {...imgProps} loading={i === 0 ? 'eager' : 'lazy'} data-lb={lbIndex(p)} class="clickable" />)}
            </div>
            <div class="under-gallery">
                <span>previous editions</span>
                {editions.map((e) => (
                    <a href={e.href} class:list={{ latest: e.latest }}>{e.label}{e.latest && ' · pictures'}</a>
                ))}
            </div>
        </div>
    </div>

    <section class="col section label-grid">
        <div class="label">Next edition</div>
        <div class="next-body">
            <div><span class="edition">{nextEdition.label}</span> <span class="meta">· {nextEdition.city} · {nextEdition.date}</span></div>
            <div class="next-cta"><button type="button" class="text-btn" data-open-attend>Keep me posted →</button></div>
        </div>
    </section>

    <section class="col section">
        <div class="said-head">
            <div class="label said-label">What people said</div>
            <a href={links.twitter} class="more">more on twitter →</a>
        </div>
        <Quotes tweets={tweets} />
    </section>

    <Footer page="home" />
    <Modals />
    <Lightbox photos={photos} />
</Base>

<style>
    .hero-wrap {
        min-height: 780px;
        display: flex;
        flex-direction: column;
        padding-top: 24px;
        padding-bottom: 40px;
    }
    .hero {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 64px 0 48px;
    }
    h1 {
        margin-bottom: 20px;
        font-size: clamp(48px, 7vw, 88px);
        font-weight: 800;
        line-height: .95;
        letter-spacing: -.04em;
        color: var(--white);
        white-space: nowrap;
    }
    .tagline { margin-bottom: 12px; font-size: 26px; line-height: 1.3; max-width: 28ch; text-wrap: pretty; color: var(--white); }
    .summary { margin-bottom: 36px; font-size: 16px; color: var(--ink-2); line-height: 1.5; max-width: 60ch; text-wrap: pretty; }
    .ctas { display: flex; gap: 10px; flex-wrap: wrap; }
    .under-gallery {
        display: flex;
        gap: 6px 16px;
        flex-wrap: wrap;
        margin-top: 14px;
        font-size: 14px;
        color: var(--ink-2);
    }
    .under-gallery a.latest { color: var(--white); font-weight: 600; }
    .under-gallery a.latest:hover { color: var(--red); }
    .clickable { cursor: zoom-in; transition: opacity .15s; }
    .clickable:hover { opacity: .85; }

    .section { padding-top: 64px; padding-bottom: 64px; border-top: 1px solid var(--line); }
    .next-body { font-size: 17px; line-height: 1.5; }
    .edition { font-weight: 600; color: var(--white); }
    .meta { color: var(--ink-2); }
    .next-cta { margin-top: 12px; font-size: 15px; }

    .said-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 20px;
    }
    .said-label { padding-top: 0; }
    .more { font-size: 14px; }

    @media (max-width: 640px) {
        .tagline { font-size: 22px; }
        .hero-wrap .photo-grid { grid-template-columns: 1fr; }
    }
</style>
