---
import Base from '../layouts/Base.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Modals from '../components/Modals.astro';
import site from '../data/site.json';

const { conspirators } = site;
---

<Base title="Conspirators — Basedcon" description="In case you want to co-curate an event in your city with us, reach out to any of us.">
    <AnnouncementBar />

    <div class="page">
        <div class="col nav-wrap"><Nav wordmark current="conspirators" /></div>

        <header class="col head">
            <h1>Conspirators</h1>
            <p class="tagline">a little bit more about us</p>
            <p class="summary">In case you want to co-curate an event in your city with us, reach out to any of us.</p>
        </header>

        <section class="col who label-grid">
            <div class="label who-label">Who we are</div>
            <div>
                {conspirators.map((p) => (
                    <div class="person">
                        <div class="person-text">
                            <span class="name">{p.name}</span>
                            <span class="bio">{p.bio}</span>
                        </div>
                        {p.links.length > 0 && (
                            <div class="person-links">
                                {p.links.map((l) => <a href={l.href}>{l.label}</a>)}
                            </div>
                        )}
                    </div>
                ))}
            </div>
        </section>

        <div class="spacer"></div>
        <Footer page="conspirators" />
    </div>
    <Modals />
</Base>

<style>
    .page { min-height: calc(100vh - 47px); display: flex; flex-direction: column; }
    .nav-wrap { padding-top: 24px; }
    .head { padding-top: 64px; padding-bottom: 48px; }
    h1 {
        margin-bottom: 20px;
        font-size: clamp(48px, 7vw, 88px);
        font-weight: 800;
        line-height: .95;
        letter-spacing: -.04em;
    }
    .tagline { margin-bottom: 12px; font-size: 26px; line-height: 1.3; max-width: 28ch; text-wrap: pretty; }
    .summary { font-size: 16px; color: var(--ink-2); line-height: 1.5; max-width: 60ch; text-wrap: pretty; }

    .who { padding-top: 48px; padding-bottom: 64px; border-top: 1px solid var(--line); }
    .who-label { padding-top: 20px; }
    .person {
        padding: 18px 0;
        border-bottom: 1px solid var(--line);
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 24px;
        align-items: center;
    }
    .person-text { min-width: 0; display: flex; flex-direction: column; gap: 3px; }
    .name { font-size: 16px; font-weight: 600; line-height: 1.3; }
    .bio { font-size: 14px; color: var(--ink-2); line-height: 1.4; text-wrap: pretty; }
    .person-links { display: flex; gap: 14px; font-size: 13px; white-space: nowrap; }
    .person-links a { color: var(--ink-2); }
    .person-links a:hover { color: var(--red); }
    .spacer { flex: 1; }

    @media (max-width: 640px) { .tagline { font-size: 22px; } }
    @media (max-width: 900px) { .who-label { padding-top: 0; } }
</style>
