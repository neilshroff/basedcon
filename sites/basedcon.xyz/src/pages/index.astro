---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Modals from '../components/Modals.astro';
import Icons from '../components/Icons.astro';
import site from '../data/site.json';

import Lightbox from '../components/Lightbox.astro';
import type { ImageMetadata } from 'astro';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/gallery/*.{png,jpg,jpeg}', { eager: true });
const g = (name: string) => {
    const key = Object.keys(files).find((k) => k.endsWith('/' + name));
    if (!key) throw new Error(`gallery photo not found: ${name}`);
    return files[key].default;
};

// Order = lightbox order. First 3 are the hero, next 9 the grid, the rest only in the lightbox.
const pool = [
    { src: g('basedcon5-5784.jpg'), alt: 'Between sessions, Basedcon Bangalore' },
    { src: g('mumbai-2024-0276.jpg'), alt: 'Group photo, Basedcon Mumbai' },
    { src: g('3.jpeg'), alt: 'Basedcon Bengaluru v2 poster' },
    { src: g('basedcon5-6395.jpg'), alt: 'Blue hour at Basedcon Bangalore' },
    { src: g('basedcon5-pizza-room.jpg'), alt: 'The room at night, Basedcon Bangalore' },
    { src: g('basedcon5-6599.jpg'), alt: 'Around the table, Basedcon Bangalore' },
    { src: g('4.jpeg'), alt: 'Basedcon BLR poster' },
    { src: g('2.jpeg'), alt: 'Building Institutions, Bangalore, March 2025' },
    { src: g('8.png'), alt: 'Group photo, Basedcon Mumbai' },
    { src: g('mumbai-2024-0319.jpg'), alt: 'A conversation by the window, Basedcon Mumbai' },
    { src: g('9.png'), alt: 'Listening in front of the flag, Basedcon Mumbai' },
    { src: g('mumbai-2024-0225.jpg'), alt: 'Speaker in front of the flag' },
    { src: g('basedcon5-5946.jpg'), alt: 'A hand goes up at the back' },
    { src: g('mumbai-2024-0307.jpg'), alt: 'Making a point' },
    { src: g('basedcon5-6185.jpg'), alt: 'Making a point by the window' },
    { src: g('mumbai-2024-bom.jpg'), alt: 'Basedcon BOM poster' },
    { src: g('mumbai-2024-0178.jpg'), alt: 'An interruptor raises a hand' },
    { src: g('basedcon5-6711.jpg'), alt: 'Evening conversation' },
    { src: g('mumbai-2024-0171.jpg'), alt: 'Speaker and audience' },
    { src: g('basedcon5-5917.jpg'), alt: 'Listening' },
    { src: g('mumbai-2024-0079.jpg'), alt: 'The flag in the window' },
    { src: g('basedcon5-5719.jpg'), alt: 'Laughing between sessions' },
    { src: g('mumbai-2024-0179.jpg'), alt: 'A guest mid-argument' },
    { src: g('basedcon5-6300.jpg'), alt: 'Speaker and two listeners' },
    { src: g('basedcon5-6740.jpg'), alt: 'Three at the door' },
    { src: g('basedcon5-5823.jpg'), alt: 'Speaker at the table' },
    { src: g('basedcon5-6494.jpg'), alt: 'Arms crossed, unconvinced' },
    { src: g('basedcon5-6501.jpg'), alt: 'The room at night' },
    { src: g('basedcon5-6427.jpg'), alt: 'Making the case' },
];
const hero = pool.slice(0, 3);
const grid = pool.slice(3, 12);
// A photo may sit in both hero and grid; the lightbox lists each once.
const lightbox = pool.filter((p, i) => pool.findIndex((q) => q.src === p.src) === i);
const lbIndex = (p: (typeof pool)[number]) => lightbox.findIndex((q) => q.src === p.src);
const { nextEvent, previousEvents, links, stats } = site;
const [themeHead, themeTail] = nextEvent.theme.endsWith(' x') ? [nextEvent.theme.slice(0, -1), 'x'] : [nextEvent.theme, ''];
const imgProps = { widths: [360, 720], sizes: '(max-width: 480px) 100vw, (max-width: 760px) 50vw, 304px' };
---

<Base>
    <AnnouncementBar />

    <div class="col hero-wrap">
        <Nav />

        <div class="hero">
            <h1>Basedcon 🇮🇳</h1>
            <p class="tagline">event series for your biggest ideas</p>
            <p class="summary">Invite-only, closed-door, across India since 2023.<br />5 speakers, up to 25 interruptors, Chatham House rules.</p>
            <div class="ctas">
                <button type="button" class="btn" data-open-invite>Join the next event</button>
                {links.pastGuestsDoc ? (
                    <a href={links.pastGuestsDoc} class="btn btn-outline" target="_blank" rel="noopener" title="Opens a Google Doc">View past guests <Icons name="external" /></a>
                ) : (
                    <a href="#" class="btn btn-outline" title="Opens a Google Doc" aria-disabled="true">View past guests <Icons name="external" /></a>
                )}
            </div>
        </div>

        <div>
            <div class="photo-grid">
                {hero.map((p, i) => <Image src={p.src} alt={p.alt} {...imgProps} loading={i === 0 ? 'eager' : 'lazy'} data-lb={lbIndex(p)} class="clickable" />)}
            </div>
            <div class="under-gallery">
                <span>{stats}</span>
                <a href="#previous-events" data-scroll>see all highlights ↓</a>
            </div>
        </div>
    </div>

    <section class="col section label-grid">
        <div class="label">What it is</div>
        <div class="body">
            <p>Every few months we host invite-only closed-door events across the country, for ambitious Indians to talk about their biggest, boldest and baddest ideas. Only your theses that you can't talk about on Twitter are allowed. Only 5 speakers presenting each time, handpicked audience of up to 25 (we call them "interruptors") and chatam house rules.</p>
            <p>We've hosted top founders, engineers, ecosystem builders, journalists, civic activists, political workers, and all kinds of people from across India in our previous events. Doesn't matter where you are and what you do, if you think you have something interesting to add, we will pay for your flights to come in.</p>
        </div>
    </section>

    <section class="col section">
        <div class="label-grid next">
            <div class="label">Next event</div>
            <div class="next-body">
                <div><span class="city">{nextEvent.city}</span> <span class="meta">· {nextEvent.date} · theme: {themeHead}{themeTail && <em class="x">{themeTail}</em>}</span></div>
                <div class="next-cta"><button type="button" class="text-btn" data-open-invite>Request an invite →</button></div>
            </div>
        </div>

        <div class="label-grid" id="previous-events">
            <div class="label">Previous events</div>
            <ul class="events">
                {previousEvents.map((ev) => (
                    <li>
                        <a href={ev.url} class="city-link">{ev.city}</a>
                        <span class="meta"> · {ev.when}{ev.note && ` · ${ev.note}`}</span>
                    </li>
                ))}
            </ul>
        </div>

        <div class="photo-grid grid-9">
            {grid.map((p) => <Image src={p.src} alt={p.alt} {...imgProps} loading="lazy" data-lb={lbIndex(p)} class="clickable" />)}
        </div>
    </section>

    <Footer page="home" />
    <Modals />
    <Lightbox photos={lightbox} />
</Base>

<style>
    .hero-wrap {
        min-height: 780px;
        display: flex;
        flex-direction: column;
        padding-top: 24px;
        padding-bottom: 40px;
    }
    .hero {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 64px 0 48px;
    }
    h1 {
        margin-bottom: 20px;
        font-size: clamp(48px, 7vw, 88px);
        font-weight: 800;
        line-height: .95;
        letter-spacing: -.04em;
        text-wrap: balance;
    }
    .tagline { margin-bottom: 12px; font-size: 26px; line-height: 1.3; max-width: 28ch; text-wrap: pretty; }
    .summary { margin-bottom: 36px; font-size: 16px; color: var(--ink-2); line-height: 1.5; max-width: 60ch; text-wrap: pretty; }
    .ctas { display: flex; gap: 10px; flex-wrap: wrap; }
    .under-gallery {
        display: flex;
        gap: 6px 16px;
        flex-wrap: wrap;
        margin-top: 14px;
        font-size: 14px;
        color: var(--ink-2);
    }
    .under-gallery a { margin-left: auto; }

    .section { padding-top: 64px; padding-bottom: 64px; border-top: 1px solid var(--line); }
    .body { font-size: 18px; line-height: 1.6; max-width: 66ch; text-wrap: pretty; }
    .body p + p { margin-top: 18px; }

    .next { padding-bottom: 40px; margin-bottom: 40px; border-bottom: 1px solid var(--line); }
    .next-body { font-size: 17px; line-height: 1.5; }
    .city { font-weight: 600; }
    .meta { color: var(--ink-2); }
    .x { font-family: "Times New Roman", Times, serif; font-style: italic; font-size: 1.1em; }
    .next-cta { margin-top: 12px; display: flex; gap: 16px; font-size: 15px; }

    .events { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 12px; font-size: 17px; line-height: 1.4; }
    .city-link { color: var(--ink); font-weight: 600; }
    .city-link:hover { color: var(--red); }

    .grid-9 { margin-top: 32px; }
    /* Posters sit at grid positions 1/5/6. On the 2-column layout 5 and 6
       would share a row, so swap 6 and 7. */
    @media (max-width: 760px) and (min-width: 481px) {
        .grid-9 > :nth-child(6) { order: 7; }
        .grid-9 > :nth-child(7) { order: 6; }
        .grid-9 > :nth-child(1) { order: 1; }
        .grid-9 > :nth-child(2) { order: 2; }
        .grid-9 > :nth-child(3) { order: 3; }
        .grid-9 > :nth-child(4) { order: 4; }
        .grid-9 > :nth-child(5) { order: 5; }
        .grid-9 > :nth-child(8) { order: 8; }
        .grid-9 > :nth-child(9) { order: 9; }
    }
    .clickable { cursor: zoom-in; transition: opacity .15s; }
    .clickable:hover { opacity: .88; }

    @media (max-width: 640px) {
        .tagline { font-size: 22px; }
        .hero-wrap .photo-grid { grid-template-columns: 1fr; }
    }
</style>

<script>
    document.querySelector('[data-scroll]')?.addEventListener('click', (e) => {
        const target = document.getElementById('previous-events');
        if (!target) return;
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        history.replaceState(null, '', '#previous-events');
    });
</script>
