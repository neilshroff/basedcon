---
interface Props {
    name: 'external' | 'link';
    size?: number;
}
const { name, size = name === 'external' ? 14 : 16 } = Astro.props;
---

{name === 'external' && (
    <svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M14 4h6v6M20 4l-9 9M19 14v5a1 1 0 01-1 1H5a1 1 0 01-1-1V6a1 1 0 011-1h5"/></svg>
)}
{name === 'link' && (
    <svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M10 14a4 4 0 005.66 0l3-3a4 4 0 00-5.66-5.66l-1.5 1.5M14 10a4 4 0 00-5.66 0l-3 3a4 4 0 005.66 5.66l1.5-1.5"/></svg>
)}
