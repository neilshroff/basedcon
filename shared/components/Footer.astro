---
interface Link {
    label: string;
    href: string;
}

interface Props {
    links: Link[];
}

const { links } = Astro.props;
---

<hr />

<footer>
    <nav>
        {links.map((link, i) => (
            <>
                {i > 0 && ' • '}
                <a href={link.href}>{link.label}</a>
            </>
        ))}
    </nav>
</footer>
